<div class="row">
    <div class="col-sm-12 col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="fa-solid fa-temperature-half"></i>
                {{ _('Temperature Sensors') }}
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-6 col-sm-4 col-md-3" data-bind="foreach: sensors">
                        <div class="i2ccc-sensor">
                            <div class="i2ccc-sensor-name" data-bind="text: name"></div>
                            <div class="i2ccc-sensor-value" data-bind="text: value"></div>
                        </div>
                    </div>
                    <div class="col-xs-12" data-bind="visible: sensors().length === 0">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        {{ _('No 1-wire temperature sensors detected.') }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12 col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="fa-solid fa-fan"></i>
                {{ _('Vent Valve') }}
            </div>
            <div class="panel-body">
                <label class="i2ccc-valve-label">{{ _('Open percentage') }}</label>
                <input type="range" min="0" max="100" step="1" class="i2ccc-slider"
                       data-bind="value: valveSlider, event: { change: valveSliderCb }">
                <div class="row i2ccc-value-row">
                    <div class="col-xs-7 i2ccc-position" data-bind="text: valvePositionText"></div>
                    <div class="col-xs-5 text-right">
                        <button type="button" class="btn btn-xs btn-default" data-bind="click: valveCloseCb">
                            {{ _('Close') }}
                        </button>
                        <button type="button" class="btn btn-xs btn-default" data-bind="click: valveOpenCb">
                            {{ _('Open') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="fa-solid fa-sliders"></i>
                {{ _('Case Status') }}
            </div>
            <div class="panel-body">
                <table class="table table-condensed i2ccc-state-table">
                    <tr>
                        <td>{{ _('Machine Power') }}</td>
                        <td class="text-right">
                            <span class="label i2ccc-state-label"
                                  data-bind="css: machinePowerState, text: machinePowerLabel"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>{{ _('Vent Fan Power') }}</td>
                        <td class="text-right">
                            <span class="label i2ccc-state-label"
                                  data-bind="css: fanPowerState, text: fanPowerLabel"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>{{ _('Case Light') }}</td>
                        <td class="text-right">
                            <span class="label i2ccc-state-label"
                                  data-bind="css: caseLightState, text: caseLightLabel"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>{{ _('Machine Light') }}</td>
                        <td class="text-right">
                            <span class="label i2ccc-state-label"
                                  data-bind="css: machineLightState, text: machineLightLabel"></span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
